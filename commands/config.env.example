# Copy this to config.env and edit. config.env is git-ignored / kept private.
# Every value below is a placeholder — no real account data lives in this template.
#
# What each setting means, its default, whether it is required, and whether it is
# updatable is documented in docs/configuration.md. This file is just the template:
# fill the required values, then review the rest against their defaults.
#
# Required before the baseline will run:
#   ALERT_EMAIL         inbox for budget + anomaly alerts
#   DAILY_DRIVER_USER   everyday IAM user (created, or verified if CREATE_DAILY_DRIVER=false)
#   CONTACT_NAME        when ENABLE_CONTACTS=true
#   CONTACT_PHONE       when ENABLE_CONTACTS=true
#
# A few values that aren't self-evident:
#   RECOVERY_EMAIL              independent mailbox for alternate contacts; use a
#                              different provider than ALERT_EMAIL/root
#   ADMIN_MAX_SESSION_DURATION admin role cap in seconds (AWS range 3600..43200)
#   ADMIN_SESSION_DURATION     requested per assume, in seconds (900..cap)
#   MONTHLY_BUDGET_AMOUNT      USD; alerts ALERT_EMAIL at 80% of this
#   ANOMALY_THRESHOLD          USD; alert when an anomaly's impact meets this
#   PREFERRED_REGION           default region when the AWS CLI has none set
#   REGIONS                    defaults to PREFERRED_REGION if left empty
#   RESOURCE_TAGS              tag created resources with ManagedBy (true/false)
#   MANAGED_BY_TAG             value of the ManagedBy tag (key is fixed)

# --- Notifications ---
ALERT_EMAIL=""
RECOVERY_EMAIL=""

# --- Daily-driver IAM user (runs first) ---
CREATE_DAILY_DRIVER=true
DAILY_DRIVER_USER=""
DAILY_DRIVER_GROUP="daily-drivers"

# --- Admin role (assumable with MFA; on by default) ---
CREATE_ADMIN_ROLE=true
ADMIN_ROLE="admin-role"
ADMIN_GROUP="admins"
WRITE_ADMIN_PROFILE=true
ADMIN_PROFILE_NAME="admin"
ADMIN_MAX_SESSION_DURATION=3600
ADMIN_SESSION_DURATION=1800

# --- Alternate contacts ---
CONTACT_NAME=""
CONTACT_PHONE=""
CONTACT_TITLE="Owner"
ENABLE_CONTACTS=true

# --- S3 account public-access block ---
ENABLE_S3_BLOCK=true

# --- Budgets ---
ENABLE_BUDGETS=true
MONTHLY_BUDGET_AMOUNT="10"

# --- Cost Anomaly Detection ---
ENABLE_ANOMALY=true
ANOMALY_MONITOR_NAME="account-services-monitor"
ANOMALY_SUBSCRIPTION_NAME="account-anomaly-alerts"
ANOMALY_THRESHOLD="10"

# --- Regions ---
PREFERRED_REGION="us-east-1"
REGIONS=""

# --- Resource tags (provenance) ---
RESOURCE_TAGS=true
MANAGED_BY_TAG="personal-aws-account-baseline"
